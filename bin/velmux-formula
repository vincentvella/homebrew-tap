#!/bin/sh
# Render Formula/velmux.rb for a velmux release from its SHA256SUMS.
#   bin/velmux-formula v0.1.0 [SHA256SUMS]   (fetches the sums if not given)
set -eu

tag=$1
version=${tag#v}
repo=vincentvella/velmux
sums=${2:-}
if [ -z "$sums" ]; then
  sums=$(mktemp)
  curl -fsSL "https://github.com/$repo/releases/download/$tag/SHA256SUMS" -o "$sums"
fi

sha() {
  hash=$(grep "velmux-$tag-$1.tar.gz\$" "$sums" | cut -d' ' -f1)
  [ -n "$hash" ] || { echo "no checksum for $1 in $sums" >&2; exit 1; }
  echo "$hash"
}

url() {
  echo "https://github.com/$repo/releases/download/$tag/velmux-$tag-$1.tar.gz"
}

mkdir -p Formula
cat > Formula/velmux.rb <<EOF
# Generated by bin/velmux-formula from the $tag release; don't edit by hand.
class Velmux < Formula
  desc "Terminal workspace for running many coding agents on warm git worktrees"
  homepage "https://github.com/$repo"
  version "$version"
  license "MIT"

  on_macos do
    on_arm do
      url "$(url aarch64-apple-darwin)"
      sha256 "$(sha aarch64-apple-darwin)"
    end
    on_intel do
      url "$(url x86_64-apple-darwin)"
      sha256 "$(sha x86_64-apple-darwin)"
    end
  end

  on_linux do
    on_arm do
      url "$(url aarch64-unknown-linux-musl)"
      sha256 "$(sha aarch64-unknown-linux-musl)"
    end
    on_intel do
      url "$(url x86_64-unknown-linux-musl)"
      sha256 "$(sha x86_64-unknown-linux-musl)"
    end
  end

  depends_on "git"

  def install
    bin.install "velmux"
  end

  def caveats
    <<~EOS
      Teach Claude Code to work in velmux:
        velmux skill install
      Ghostty keybinds for the prefix-less shortcuts:
        velmux keys --ghostty
      A running velmux restarts into the new version by itself after an upgrade.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/velmux --version")
  end
end
EOF
echo "Formula/velmux.rb → $version"
